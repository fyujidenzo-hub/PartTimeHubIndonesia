# Supabase project URL (Project Settings > API)
VITE_SUPABASE_URL=

# Supabase publishable key. Never use a secret or service-role key in the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Keep true for UI preview without Supabase. Set false to require a real Supabase connection.
VITE_ENABLE_DEMO_MODE=true
